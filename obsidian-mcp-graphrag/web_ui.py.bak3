async function fetchLimitUp(){
try{
const r=await fetch('/limit-up');
if(r.status===401)return;
const d=await r.json();
document.getElementById('limitUpLoading').style.display='none';
document.getElementById('limitUpContent').style.display='block';
document.getElementById('limitUpTable').innerHTML=_buildStockTable(d.limit_up||[],true);
document.getElementById('topGainersTable').innerHTML=d.top_gainers&&d.top_gainers.length?_buildStockTable(d.top_gainers,true):'<div style="color:#666;font-size:13px">暂无</div>';
}catch(e){document.getElementById('limitUpLoading').textContent='加载失败';}
}
function _buildStockTable(rows,showWatch){
if(!rows.length)return'<div style="color:#666;font-size:13px;padding:10px">暂无数据</div>';
let h='<table class="stock-table"><tr><th>股票</th><th>现价</th><th>涨跌幅</th><th>换手</th><th>量比</th><th>振幅</th>'+(showWatch?'<th>自选</th>':'')+'</tr>';
rows.forEach(r=>{
const cls=r.change>=0?'up':'down';
h+='<tr><td><b style="color:#eee">'+esc(r.name)+'</b><br><span style="color:#888;font-size:11px">'+esc(r.code)+'</span></td><td style="color:#eee">'+esc(r.price)+'</td><td class="'+cls+'">'+(r.change>=0?'+':'')+r.change.toFixed(2)+'%</td><td>'+esc(r.turnover?r.turnover.toFixed(1):'--')+'%</td><td>'+esc(r.vol_ratio?r.vol_ratio.toFixed(2):'--')+'</td><td>'+esc(r.amplitude?r.amplitude.toFixed(1):'--')+'%</td>'+(showWatch?'<td><button class="watch-btn" data-code="'+esc(r.code)+'" data-name="'+esc(r.name)+'" data-price="'+esc(r.price)+'" data-change="'+r.change_str+'" style="background:none;border:none;cursor:pointer;font-size:18px" title="添加/移除自选">'+(isWatched(r.code)?'⭐':'☆')+'</button></td>':'')+'</tr>';
});
h+='</table>';
return h;
}

