function _buildMiniTable(rows){
if(!rows.length)return'<div style="color:#666;font-size:13px;padding:6px">暂无</div>';
let h='<table class="stock-table"><tr><th>股票</th><th>现价</th><th>涨跌</th><th>值</th><th>⭐</th></tr>';
rows.forEach(r=>{
const cls=r.change>=0?'up':'down';
let val=r.vol_ratio||r.amplitude||r.turnover||0;
h+='<tr><td><b style="color:#eee">'+esc(r.name)+'</b><br><span style="color:#888;font-size:11px">'+esc(r.code)+'</span></td><td style="color:#eee">'+esc(r.price)+'</td><td class="'+cls+'">'+r.change_str+'</td><td style="color:#ff9f43;font-weight:bold">'+val.toFixed(2)+'</td><td><button class="watch-btn" data-code="'+esc(r.code)+'" data-name="'+esc(r.name)+'" data-price="'+esc(r.price)+'" data-change="'+r.change_str+'" style="background:none;border:none;cursor:pointer;font-size:18px" title="添加/移除自选">'+(isWatched(r.code)?'⭐':'☆')+'</button></td></tr>';
});
h+='</table>';
return h;
}

// ═══════════ 自选股 ═══════════
const WATCH_KEY='kb_watchlist';
function getWatchlist(){try{return JSON.parse(localStorage.getItem(WATCH_KEY)||'[]')}catch(e){return[]}}
function saveWatchlist(list){localStorage.setItem(WATCH_KEY,JSON.stringify(list))}
function isWatched(code){return getWatchlist().some(w=>w.code===code)}
function toggleWatch(code,name,price,change_str){
let list=getWatchlist();
const idx=list.findIndex(w=>w.code===code);
if(idx>=0){list.splice(idx,1)}else{list.push({code,name,price,change_str,addedAt:new Date().toISOString()})}
saveWatchlist(list);renderWatchlist();
// 刷新当前 tab
if(currentMarketTab==='limitup')fetchLimitUp();
if(currentMarketTab==='abnormal')fetchAbnormal();
}
function removeFromWatch(code){toggleWatch(code,'','','')}
function renderWatchlist(){
const list=getWatchlist();
const dom=document.getElementById('watchlistContent');
if(!list.length){dom.innerHTML='<div class="watchlist-empty">暂无自选，在涨停板/异动/荐股中点击 ⭐ 添加</div>';return}
let h='';
list.forEach(w=>{h+='<div class="watch-card"><div><span class="w-name">'+esc(w.name)+'</span><span class="w-code">'+esc(w.code)+'</span></div><div style="text-align:right"><div class="w-price">'+esc(w.price)+'</div><div class="w-change '+(w.change_str&&w.change_str.startsWith('-')?'down':'up')+'">'+esc(w.change_str||'--')+'</div></div><button class="w-remove-btn" data-code="'+esc(w.code)+'" title="移除">✕</button></div>'});
dom.innerHTML=h;
}

