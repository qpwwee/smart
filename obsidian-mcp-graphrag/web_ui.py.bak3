.watchlist-empty{text-align:center;color:#666;padding:20px;font-size:13px}
.watch-card{display:flex;align-items:center;justify-content:space-between;background:#1a1a2e;border-radius:10px;padding:10px 16px;margin-bottom:6px;border:1px solid #2a2a4a}
.watch-card .w-name{font-size:15px;color:#eee;font-weight:600;min-width:100px}
.watch-card .w-code{font-size:11px;color:#888;margin-left:6px}
.watch-card .w-price{font-size:16px;color:#eee;text-align:right}
.watch-card .w-change{font-size:14px;font-weight:bold;text-align:right;min-width:70px}
.watch-card .w-remove{background:none;border:none;color:#555;cursor:pointer;font-size:16px;padding:4px 8px;border-radius:4px}
.watch-card .w-remove:hover{color:#ff6b6b;background:rgba(255,107,107,.1)}
.index-name{color:#888;font-size:12px;margin-bottom:6px}
.index-price{color:#e0e0e0;font-size:18px;font-weight:bold;margin-bottom:4px}
.index-change{font-size:14px;font-weight:bold}
.index-change.up{color:#00d4aa}
.index-change.down{color:#ff6b6b}
.sector-chart-wrap{background:#1a1a2e;border-radius:12px;padding:16px;border:1px solid #2a2a4a}
.sector-chart-title{color:#888;font-size:13px;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.sector-chart{width:100%;height:360px}
.market-loading{text-align:center;color:#555;padding:40px;font-size:14px}
@media(max-width:768px){
.index-cards{gap:6px}
.index-card{min-width:80px;padding:10px}
.index-price{font-size:15px}
.sector-chart{height:280px}
}
</style>
</head>
<body>
<div class="header">
<h1>📚 Knowledge Base</h1>
<div class="header-actions">
<button class="graph-toggle" id="graphBtn" onclick="toggleGraph()">📊 知识图谱</button>
<a class="logout" href="/logout">退出</a>
</div>
</div>
<div class="search-box">
<div class="search-row">
<input class="search-input" id="q" placeholder="输入问题，回车搜索..." autofocus>
<button class="search-btn" onclick="doSearch()">🔍 搜索</button>
</div>
<div class="hint">基于 Obsidian Wiki 知识库 + AI 生成回答</div>
</div>
<div class="vision-upload" id="visionUpload" style="justify-content:center">
<label class="vision-label" id="visionLabel">🖼️ <span>上传图片识图</span>
<input type="file" id="imageInput" accept="image/*" onchange="onImageSelected(event)">
</label>
<img class="vision-preview" id="imagePreview" alt="预览">
<span class="vision-info" id="imageInfo"></span>
<button class="vision-btn" id="visionBtn" onclick="doVision()">🔍 识图</button>
<button class="camera-toggle" id="cameraToggle" onclick="toggleCamera()">📷 实时摄像头</button>
<label class="video-label" id="videoLabel">🎬 <span>上传视频分析</span>
<input type="file" id="videoInput" accept="video/*" onchange="onVideoSelected(event)">
</label>
<button class="vision-btn" id="videoGoBtn" onclick="processVideo()" style="display:none">▶ 分析</button>
<button class="video-label" id="videoCancelBtn" onclick="cancelVideo()" style="display:none;color:#ff6b6b;border-color:#ff6b6b">✕</button>
</div>
<div class="video-progress" id="videoProgress">
<div class="video-progress-bar"><div class="video-progress-fill" id="videoProgressFill"></div></div>
<div class="video-progress-text" id="videoProgressText"></div>
<div class="video-frame-results" id="videoFrameResults"></div>
</div>
<div class="camera-container" id="cameraContainer">
<div class="camera-video-wrap">
<video id="cameraVideo" autoplay playsinline muted></video>
<canvas id="cameraCanvas" style="display:none"></canvas>
</div>
<div class="camera-controls">
<button class="camera-close-btn" onclick="stopCamera()">⏹ 关闭摄像头</button>
</div>
</div>
<div class="market-panel" id="marketPanel">
  <!-- Tab 导航 -->
  <div class="market-tabs">
    <div class="market-tab active" onclick="switchMarketTab('indices')">📊 指数行情</div>
    <div class="market-tab" onclick="switchMarketTab('sectors')">📈 板块对比</div>
    <div class="market-tab" onclick="switchMarketTab('limitup')">🔥 涨停板</div>
    <div class="market-tab" onclick="switchMarketTab('abnormal')">⚡ 异动监控</div>
    <div class="market-tab" onclick="switchMarketTab('pick')">🧠 AI 荐股</div>
  </div>
  <span class="market-refresh" id="refreshHint" style="float:right;color:#666;font-size:11px;margin-top:-30px">每30秒自动刷新</span>

  <!-- Tab: 指数行情 -->
  <div class="market-tab-content active" id="tab-indices">
    <div class="market-loading" id="marketLoading">📊 加载股市行情中...</div>
    <div id="marketContent" style="display:none">
      <div class="market-header">
        <h2>📈 <span id="marketDate">-</span> A股市场</h2>
        <span class="market-time" id="marketTime">-</span>
      </div>
      <div class="index-cards" id="indexCards"></div>
    </div>
  </div>

  <!-- Tab: 板块对比 -->
  <div class="market-tab-content" id="tab-sectors">
    <div class="sector-chart-wrap">
      <div class="sector-chart" id="sectorChart" style="height:400px"></div>
    </div>
  </div>

  <!-- Tab: 涨停板 -->
  <div class="market-tab-content" id="tab-limitup">
    <div class="market-loading" id="limitUpLoading">🔥 加载涨停板数据...</div>
    <div id="limitUpContent" style="display:none">
      <h4 style="color:#ccc;margin:0 0 10px">🔴 今日涨停股</h4>
      <div id="limitUpTable"></div>
      <h4 style="color:#ccc;margin:16px 0 10px">🟠 热门涨幅（≥5%）</h4>
      <div id="topGainersTable"></div>
    </div>
  </div>

  <!-- Tab: 异动监控 -->
  <div class="market-tab-content" id="tab-abnormal">
    <div class="market-loading" id="abnormalLoading">⚡ 加载异动数据...</div>
    <div id="abnormalContent" style="display:none">
      <div class="abnormal-grid">
        <div class="abnormal-col">
          <h4>📊 量比 TOP（放量）</h4>
          <div id="volRatioTable"></div>
        </div>
        <div class="abnormal-col">
          <h4>📉 振幅 TOP（异动）</h4>
          <div id="amplitudeTable"></div>
        </div>
        <div class="abnormal-col">
          <h4>🔄 换手率 TOP（活跃）</h4>
          <div id="turnoverTable"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab: AI 荐股 -->
  <div class="market-tab-content" id="tab-pick">
    <div class="market-search" style="display:flex;gap:8px;align-items:center;margin-bottom:10px">
      <input type="text" id="stockQuery" placeholder="例：新能源龙头股 / AI概念股 / 半导体芯片" style="flex:1;padding:8px 12px;border:1px solid #3a3a5c;border-radius:8px;background:#1a1a2e;color:#eee;font-size:14px" onkeydown="if(event.key==='Enter')doStockPick()">
      <button onclick="doStockPick()" style="padding:8px 16px;border-radius:8px;border:none;background:#6c63ff;color:#fff;font-size:14px;cursor:pointer;white-space:nowrap">🔍 分析推荐</button>
    </div>
    <div id="stockPickLoading" class="market-loading" style="display:none">AI 正在分析市场数据…</div>
    <div id="stockPickResult" style="display:none;margin-top:10px">
      <div id="stockPickSummary" style="color:#bbb;font-size:13px;margin-bottom:10px"></div>
      <div id="stockPickCards" style="display:flex;flex-wrap:wrap;gap:10px"></div>
    </div>
  </div>
</div>

<!-- ⭐ 自选股 -->
<div class="watchlist-panel" id="watchlistPanel">
  <h3 style="color:#ccc;margin:0 0 10px;font-size:15px">⭐ 自选股 <span style="color:#888;font-size:11px;font-weight:normal">（点击股票卡片上的 ☆ 添加）</span></h3>
  <div id="watchlistContent"><div class="watchlist-empty">暂无自选，在涨停板/异动/荐股中点击 ⭐ 添加</div></div>
</div>

<div id="output"></div>
<div class="graph-container" id="graphContainer">
<div class="graph-canvas-wrap">
<div class="graph-canvas" id="graphCanvas"></div>
<button class="graph-reset" onclick="resetGraph()">⟳ 重置视图</button>
</div>
<div class="graph-legend">
<span><span class="dot" style="background:#6c63ff"></span>概念</span>
<span><span class="dot" style="background:#00d4aa"></span>实体</span>
<span><span class="dot" style="background:#ff9f43"></span>来源</span>
<span><span class="dot" style="background:#888"></span>其他</span>
</div>
</div>
<script>
const q=document.getElementById('q'),out=document.getElementById('output');
let selectedImage=null;
q.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();if(selectedImage){doVision()}else{doSearch()}}});
function onImageSelected(e){
const file=e.target.files[0];if(!file)return;
selectedImage=file;
const reader=new FileReader();
reader.onload=function(ev){
const preview=document.getElementById('imagePreview');
preview.src=ev.target.result;preview.style.display='block';
document.getElementById('imageInfo').textContent=file.name+' ('+(file.size/1024).toFixed(0)+'KB)';document.getElementById('imageInfo').style.display='inline';
document.getElementById('visionBtn').style.display='inline-block';
document.getElementById('visionLabel').querySelector('span').textContent='📎 换图片';
};
reader.readAsDataURL(file);
}
async function doVision(){
if(!selectedImage)return;
const btn=document.getElementById('visionBtn');btn.disabled=true;btn.textContent='⏳ 识别中...';
out.innerHTML='<div class="loading">👁️ 正在识别图片...</div>';
const form=new FormData();form.append('image',selectedImage);
const textQ=q.value.trim();
form.append('query',textQ||'请描述这张图片的内容');
try{
const r=await fetch('/vision',{method:'POST',body:form});
if(r.status===401){window.location.reload();return}
const data=await r.json();
let html='';
if(data.error){html+='<div class="empty">'+esc(data.error)+'</div>'}
html+='<div class="answer-box"><div class="answer-card"><div class="answer-label">👁️ 视觉识别</div><div class="answer-text">'+esc(data.answer)+'</div></div></div>';
out.innerHTML=html;
}catch(e){out.innerHTML='<div class="empty">识图出错: '+e.message+'</div>'}
btn.disabled=false;btn.textContent='🔍 识图';
}
let selectedVideo=null;
function onVideoSelected(e){
const file=e.target.files[0];if(!file)return;
selectedVideo=file;
document.getElementById('videoGoBtn').style.display='inline-block';
document.getElementById('videoCancelBtn').style.display='inline-flex';
document.getElementById('videoLabel').querySelector('span').textContent='📎 '+file.name;
}
function cancelVideo(){
selectedVideo=null;
document.getElementById('videoInput').value='';
document.getElementById('videoGoBtn').style.display='none';
document.getElementById('videoCancelBtn').style.display='none';
document.getElementById('videoLabel').querySelector('span').textContent='上传视频分析';
document.getElementById('videoProgress').classList.remove('show');
}
async function processVideo(){
if(!selectedVideo)return;
const video=document.createElement('video');video.preload='auto';
video.crossOrigin='anonymous';video.muted=true;
video.src=URL.createObjectURL(selectedVideo);
await new Promise(r=>{video.onloadedmetadata=r});
const duration=video.duration;
// 短视频(<10s)采样更密，长视频保持3秒间隔
const frameInterval=duration<10?Math.max(1,duration/5):3;
const maxFrames=Math.min(12,Math.floor(duration/frameInterval));
if(maxFrames<1||!video.videoWidth){alert('视频无法解析，尝试换文件');return}
const progress=document.getElementById('videoProgress');const bar=document.getElementById('videoProgressFill');
const text=document.getElementById('videoProgressText');const frDiv=document.getElementById('videoFrameResults');
progress.classList.add('show');bar.style.width='0%';text.textContent='视频时长 '+duration.toFixed(1)+'s，提取 '+maxFrames+' 帧...';
frDiv.innerHTML='';out.innerHTML='';
const canvas=document.createElement('canvas');const ctx=canvas.getContext('2d');
// 辅助：可靠 seek（addEventListener + 超时兜底）
function seekReliable(v,time,timeoutMs=5000){
return new Promise(resolve=>{
const done=()=>{v.removeEventListener('seeked',done);resolve()};
v.addEventListener('seeked',done);
v.currentTime=time;
setTimeout(()=>{v.removeEventListener('seeked',done);resolve()},timeoutMs);
});
}
// 跳到开头
await seekReliable(video,0);
// 播放一小段确保解码器初始化和首帧可读
await video.play();await new Promise(r=>setTimeout(r,300));video.pause();
const formData=new FormData();let ok=0;
for(let i=0;i<maxFrames;i++){
const t=(i+1)*frameInterval; // 从 frameInterval 开始，跳开第0帧
await seekReliable(video,Math.min(t,duration-0.1));
await new Promise(r=>setTimeout(r,200)); // 给渲染一帧的时间
canvas.width=320;const ratio=320/video.videoWidth;
canvas.height=Math.round(video.videoHeight*ratio);
ctx.drawImage(video,0,0,canvas.width,canvas.height);
const blob=await new Promise(r=>canvas.toBlob(r,'image/jpeg',.6));
if(!blob||blob.size<500)continue;
formData.append('images',blob,'f'+i+'.jpg');
ok++;
bar.style.width=Math.round(ok/maxFrames*30)+'%';
text.textContent='第 '+(i+1)+'/'+maxFrames+' 帧 @'+t.toFixed(1)+'s ('+ok+' 有效)';
}
URL.revokeObjectURL(video.src);
if(ok===0){text.textContent='❌ 未提取到有效帧 (blob<500B)，换视频试试';return}
formData.append('query','请综合分析这段视频的完整内容。包括：主题、场景、人物/物体、关键动作、氛围变化');
formData.append('max_tokens','2048');
bar.style.width='30%';text.textContent='⏳ '+ok+' 帧发给 VL 模型综合分析中...';
try{
const r=await fetch('/video-analysis',{method:'POST',body:formData});
if(r.status===401){window.location.reload();return}
const data=await r.json();
bar.style.width='100%';
if(data.error){text.textContent='❌ '+data.error}
else{
text.textContent='✅ 视频完整分析 · '+duration.toFixed(1)+'s · '+ok+'帧';
frDiv.innerHTML='<div class="result-card"><div class="result-text">'+esc(data.answer||'(空)')+'</div></div>';
}
}catch(e){text.textContent='❌ 请求失败: '+esc(e.message||'')}
}
let cameraStream=null,cameraRunning=false;
async function toggleCamera(){
const btn=document.getElementById('cameraToggle');
const container=document.getElementById('cameraContainer');
const show=!container.classList.contains('show');
if(show){
try{
cameraStream=await navigator.mediaDevices.getUserMedia({video:{width:{ideal:1280},height:{ideal:720},facingMode:'environment'},audio:false});
const video=document.getElementById('cameraVideo');
video.srcObject=cameraStream;
container.classList.add('show');
btn.classList.add('active');
btn.innerHTML='📷 <span>实时识别中...</span>';
out.innerHTML='<div class="loading">👁️ 实时识别已启动，1秒1帧...</div>';
cameraRunning=true;
realtimeLoop();
}catch(e){alert('摄像头无法访问: '+e.message);return}
}else{stopCamera()}
}
function stopCamera(){
cameraRunning=false;
if(cameraStream){cameraStream.getTracks().forEach(t=>t.stop());cameraStream=null}
document.getElementById('cameraContainer').classList.remove('show');
const btn=document.getElementById('cameraToggle');btn.classList.remove('active');btn.innerHTML='📷 <span>实时摄像头</span>';
}
async function realtimeLoop(){
const video=document.getElementById('cameraVideo');
const canvas=document.getElementById('cameraCanvas');
let seq=0;
while(cameraRunning&&video.srcObject){
if(video.readyState<2){await new Promise(r=>setTimeout(r,100));continue}
const t0=performance.now();
// 极速模式：200px + JPEG 0.35 + max_tokens 256 + 短 prompt
const MAX_SIDE=200;
let w=video.videoWidth,h=video.videoHeight;
if(w>h&&w>MAX_SIDE){const r=MAX_SIDE/w;w=MAX_SIDE;h=Math.round(h*r)}
else if(h>MAX_SIDE){const r=MAX_SIDE/h;h=MAX_SIDE;w=Math.round(w*r)}
canvas.width=w;canvas.height=h;
canvas.getContext('2d').drawImage(video,0,0,w,h);
const blob=await new Promise(r=>canvas.toBlob(r,'image/jpeg',.35));
if(!blob||!cameraRunning)break;
seq++;
const form=new FormData();form.append('image',blob,'c.jpg');
const textQ=q.value.trim();
form.append('query',textQ||'一句话描述画面内容');
form.append('max_tokens','256');
try{
const r=await fetch('/vision',{method:'POST',body:form});
if(r.status===401){stopCamera();window.location.reload();return}
const data=await r.json();
let html='<div class="answer-box"><div class="answer-card"><div class="answer-label">📸 实时识别 <span class="src-tag">#'+seq+'</span></div><div class="answer-text">'+esc(data.answer)+'</div></div></div>';
out.innerHTML=html;
}catch(e){}
const elapsed=performance.now()-t0;
const wait=Math.max(0,1000-elapsed);
if(cameraRunning)await new Promise(r=>setTimeout(r,wait));
}
}
async function doSearch(){
const query=q.value.trim();if(!query)return;
out.innerHTML='<div class="loading">🤔 正在检索知识库并生成回答...</div>';
try{
const r=await fetch('/query',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({query})});
if(r.status===401){window.location.reload();return}
const data=await r.json();
let html='';
// AI 回答区（含来源类型标签）
if(data.answer){
let srcLabel='📚 知识库';if(data.source_type==='web')srcLabel='🌐 网络搜索';else if(data.source_type==='hybrid')srcLabel='📚+🌐 知识库&网络'
html+='<div class="answer-box"><div class="answer-card"><div class="answer-label">🤖 AI 回答 <span class="src-tag">'+srcLabel+'</span></div><div class="answer-text">'+esc(data.answer)+'</div></div>';
html+='<span class="sources-toggle" onclick="toggleSources()">📋 查看知识库来源 ('+(data.results?data.results.length:0)+'条)</span>';
html+='</div>'}
// 参考来源区（默认收起）
let showSources=!data.answer;
html+='<div class="results'+(data.answer?' hidden':'')+'" id="sources">';
if(data.strategy)html+='<div class="strategy">检索策略: '+data.strategy+'</div>';
if(!data.results||!data.results.length){html+='<div class="empty">没有找到相关内容</div>'}
else{data.results.forEach(r=>{
html+='<div class="result-card"><div class="result-page">'+r.page+(r.category?'<span>'+r.category+'</span>':'')+
'<span class="result-score">相关度 '+(r.score||r.relevance||'')+'</span></div>'+
'<div class="result-text">'+esc(r.excerpt||r.text||'')+'</div>'+
'<span class="result-source">'+(r.source||'wiki')+'</span></div>'})}
html+='</div>';out.innerHTML=html
}catch(e){out.innerHTML='<div class="empty">搜索出错: '+e.message+'</div>'}
}
function esc(s){if(!s)return '';s=String(s);s=s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');return s}
function toggleSources(){const el=document.getElementById('sources');el.classList.toggle('hidden')}
let graphChart=null,graphData=null;
async function toggleGraph(){
const btn=document.getElementById('graphBtn'),container=document.getElementById('graphContainer');
const show=!container.classList.contains('show');
container.classList.toggle('show',show);btn.classList.toggle('active',show);
if(show&&!graphChart){await loadGraph()}
if(show&&graphChart){setTimeout(()=>graphChart.resize(),100)}
}
async function loadGraph(){
try{
const r=await fetch('/api/graph');
if(!r.ok)return;
graphData=await r.json();
renderGraph();
}catch(e){console.error('Graph load error:',e)}
}
function renderGraph(){
const dom=document.getElementById('graphCanvas');
if(graphChart){graphChart.dispose()}
graphChart=echarts.init(dom,null,{renderer:'canvas'});
graphChart.on('click',function(params){
if(params.dataType==='node'){
document.getElementById('q').value=params.data.name;
doSearch();
}
});
const isMobile=window.innerWidth<768;
const option={
backgroundColor:'#0d0d1a',
tooltip:{show:false},
animationDuration:600,
animationEasingUpdate:'cubicInOut',
series:[{type:'graph',layout:'force',
force:{repulsion:isMobile?120:200,edgeLength:[60,180],gravity:0.12,layoutAnimation:true,friction:0.6},
roam:true,draggable:true,
data:graphData.nodes.map(n=>({...n,symbolSize:Math.max(4,n.symbolSize*0.55),itemStyle:{color:n.itemStyle.color,opacity:0.88,borderColor:'rgba(255,255,255,.2)',borderWidth:0.6}})),
edges:graphData.edges,
lineStyle:{color:'rgba(255,255,255,.12)',curveness:0.2,width:0.7,opacity:0.5},
label:{show:false},
emphasis:{
focus:'adjacency',
lineStyle:{width:1.5,color:'rgba(255,255,255,.4)',opacity:1},
itemStyle:{opacity:1,borderColor:'rgba(255,255,255,.7)',borderWidth:2},
label:{show:true,fontSize:isMobile?14:12,fontWeight:'600',color:'#fff',backgroundColor:'rgba(13,13,26,.9)',padding:[4,10],borderRadius:4,distance:10}
},
blur:{itemStyle:{opacity:.08},lineStyle:{opacity:.02},label:{show:false}}
}]
};
graphChart.setOption(option);
window.addEventListener('resize',()=>{if(graphChart)graphChart.resize()});
}
function resetGraph(){
if(!graphChart)return;
graphChart.dispatchAction({type:'restore'});
}
// ═══════════ 股市行情面板 ═══════════
let sectorChart=null,mktInterval=null,currentMarketTab='indices';

// ═══════════ Tab 切换 ═══════════
function switchMarketTab(tab){
  currentMarketTab=tab;
  document.querySelectorAll('.market-tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.market-tab-content').forEach(c=>c.classList.remove('active'));
  document.querySelector('.market-tab[onclick*="'+tab+'"]').classList.add('active');
  document.getElementById('tab-'+tab).classList.add('active');
  if(tab==='sectors'){fetchMarket().then(function(){setTimeout(function(){if(sectorChart)sectorChart.resize()},200)})}
  else if(tab==='limitup'){fetchLimitUp()}
  else if(tab==='abnormal'){fetchAbnormal()}
  else if(tab==='indices'){fetchMarket()}
}

// ═══════════ 指数行情 ═══════════
async function fetchMarket(){
try{
const r=await fetch('/market');
if(r.status===401)return;
const d=await r.json();
if(d.error)return;
document.getElementById('marketDate').textContent=d.date||'-';
document.getElementById('marketTime').textContent='🕐 '+d.time||'-';
document.getElementById('marketLoading').style.display='none';
document.getElementById('marketContent').style.display='block';
let cards='';
(d.indices||[]).forEach(i=>{
const cls=i.change_pct>=0?'up':'down';
const sign=i.change_pct>=0?'+':'';
cards+='<div class="index-card"><div class="index-name">'+esc(i.name)+'</div><div class="index-price">'+esc(i.price)+'</div><div class="index-change '+cls+'">'+sign+esc(i.change_str)+'</div></div>';
});
if(!cards)cards='<div class="index-card" style="flex:3"><div class="index-name" style="color:#ff6b6b">数据加载中，请稍后刷新</div></div>';
document.getElementById('indexCards').innerHTML=cards;
renderSectorChart(d.sectors||[]);
}catch(e){}
}
function renderSectorChart(sectors){
const dom=document.getElementById('sectorChart');
if(!dom||!sectors.length){if(dom)dom.innerHTML='<div class="market-loading">暂无板块数据</div>';return;}
const names=sectors.map(s=>s.name.length>6?s.name.slice(0,6)+'…':s.name);
const vals=sectors.map(s=>s.change);
if(!sectorChart)sectorChart=echarts.init(dom);
sectorChart.setOption({
tooltip:{trigger:'axis',axisPointer:{type:'shadow'},formatter:function(p){return p[0].axisValue+'<br/>涨跌幅: '+(p[0].value>=0?'+':'')+p[0].value.toFixed(2)+'%'}},
grid:{left:'3%',right:'8%',bottom:'3%',containLabel:true},
xAxis:{type:'value',axisLabel:{formatter:'{value}%'},splitLine:{lineStyle:{color:'#2a2a4a'}}},
yAxis:{type:'category',data:names.reverse(),axisLabel:{color:'#aaa',fontSize:12},inverse:true},
series:[{type:'bar',data:vals.reverse().map(v=>({value:v,itemStyle:{color:v>=0?'#00d4aa':'#ff6b6b'}})),barMaxWidth:24,label:{show:true,position:'right',fontSize:12,color:'#aaa',formatter:function(p){return(p.value>=0?'+':'')+p.value.toFixed(2)+'%'}}}]
},true);
}
window.addEventListener('resize',()=>{if(sectorChart)sectorChart.resize()});

