async function doStockPick(){
const q=document.getElementById('stockQuery').value.trim();
if(!q)return;
document.getElementById('stockPickLoading').style.display='block';
document.getElementById('stockPickResult').style.display='none';
try{
const r=await fetch('/stock-pick',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({query:q})});
const d=await r.json();
document.getElementById('stockPickLoading').style.display='none';
document.getElementById('stockPickResult').style.display='block';
