cards+='<div class="index-card" style="flex:1 1 170px;min-width:150px"><div class="index-name">'+esc(p.name)+' <span style="color:#888;font-size:11px">'+esc(p.code)+'</span></div><div class="index-price">'+esc(p.price||'')+'</div><div class="index-change '+cls+'">'+esc(p.change||'')+'</div><div style="color:#aaa;font-size:11px;margin-top:4px">'+esc(p.reason||'')+'</div><button class="watch-btn" data-code="'+esc(p.code)+'" data-name="'+esc(p.name)+'" data-price="'+esc(p.price)+'" data-change="'+(p.change||'')+'" style="margin-top:6px;background:none;border:none;cursor:pointer;font-size:14px;color:#888">'+(isWatched(p.code)?'⭐已自选':'☆加自选')+'</button></div>';
});
document.getElementById('stockPickCards').innerHTML=cards||'<div style="color:#888">未识别到结构化推荐，请查看文字分析</div>';
}catch(e){
document.getElementById('stockPickLoading').style.display='none';
document.getElementById('stockPickResult').style.display='block';
document.getElementById('stockPickSummary').textContent='请求失败，请重试';
}
}

